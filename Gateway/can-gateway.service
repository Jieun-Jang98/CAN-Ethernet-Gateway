[Unit]
Description=CAN-Ethernet Gateway
After=network.target

[Service]
Type=simple
User=root
ExecStartPre=-/sbin/ip link set can0 down
ExecStartPre=/sbin/ip link set can0 type can bitrate 500000 restart-ms 100
ExecStartPre=/sbin/ip link set can0 up
ExecStartPre=/sbin/ip addr replace 192.168.50.11/24 dev eth0
ExecStartPre=/sbin/ip link set eth0 up
ExecStart=/usr/local/bin/can_gateway --can can0 --local-ip 192.168.50.11 --adas-ip 192.168.50.12 --state-port 5000 --command-port 5001
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

